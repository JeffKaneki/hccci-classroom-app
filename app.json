      },
      "predictiveBackGestureEnabled": false,
      "package": "com.j3fx.hccciroomavailability"
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
